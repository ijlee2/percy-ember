{
  "name": "@percy/ember",
  "version": "5.0.2",
  "description": "Ember client library for visual testing with Percy",
  "keywords": [
    "ember-addon",
    "percy",
    "visual testing"
  ],
  "repository": "https://github.com/percy/ember-percy",
  "license": "MIT",
  "author": "Perceptual Inc.",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./*": {
      "default": "./dist/*.js"
    },
    "./addon-main.js": "./addon-main.cjs"
  },
  "files": [
    "addon-main.cjs",
    "dist"
  ],
  "scripts": {
    "build": "rollup --config && cp types/index.d.ts dist/index.d.ts",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"yarn:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"yarn:lint:*:fix\" --names \"fix:\" && yarn format",
    "lint:format": "prettier . --cache --check",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "prepack": "rollup --config",
    "start": "rollup --config --watch",
    "test": "echo \"TODO\""
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.10.3",
    "@percy/sdk-utils": "^1.32.11"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/eslint-parser": "^8.0.6",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/runtime": "^8.0.5",
    "@ember/test-helpers": "^5.7.0",
    "@embroider/addon-dev": "^8.4.0",
    "@eslint/js": "^10.0.1",
    "@glimmer/component": "^2.1.1",
    "@glimmer/tracking": "^1.1.2",
    "@percy/cli": "^1.32.11",
    "@rollup/plugin-babel": "^7.1.0",
    "@types/mocha": "^10.0.10",
    "@types/qunit": "^2.19.14",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^10.0.5",
    "ember-source": "~7.3.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^13.5.0",
    "eslint-plugin-n": "^18.4.0",
    "eslint-plugin-qunit": "^8.2.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "rollup": "^4.63.6"
  },
  "peerDependencies": {
    "@ember/test-helpers": "^5.0.0"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">= 16"
  },
  "publishConfig": {
    "tag": "latest"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "main": "addon-main.cjs",
    "type": "addon",
    "version": 2
  }
}
